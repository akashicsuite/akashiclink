{
  "name": "@akashic/wallet-extension",
  "version": "3.0.1",
  "private": true,
  "scripts": {
    "serve": "serve -d build",
    "start:dev": "DISABLE_ESLINT_PLUGIN=true PORT=3001 craco start",
    "build": "GENERATE_SOURCEMAP=true DISABLE_ESLINT_PLUGIN=true craco build",
    "build:dev": "watch 'DISABLE_ESLINT_PLUGIN=true env-cmd -f .env craco build' ./src",
    "build:staging": "yarn lint:fix && GENERATE_SOURCEMAP=true DISABLE_ESLINT_PLUGIN=true env-cmd -f .env.staging.local craco build",
    "build:preprod": "yarn lint:fix && GENERATE_SOURCEMAP=true DISABLE_ESLINT_PLUGIN=true env-cmd -f .env.preprod.local craco build",
    "build:prod": "yarn lint:fix && GENERATE_SOURCEMAP=true DISABLE_ESLINT_PLUGIN=true env-cmd -f .env.production.local craco build",
    "deploy:chrome-extension": "yarn build:staging && cd extension && env-cmd -f .env.staging node deploy.mjs",
    "deploy:preprod:chrome-extension": "yarn build:preprod && cd extension && env-cmd -f .env.preprod node deploy.mjs",
    "deploy:prod:chrome-extension": "yarn build:prod && cd extension && env-cmd -f .env.production node deploy.mjs",
    "lint": "npx eslint . --cache",
    "lint:fix": "yarn lint --fix",
    "prettier:check": "npx prettier --check \"**/*.ts\"",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run",
    "test-watch": "vitest",
    "storybook": "REACT_APP_API_BASE_URL=http://localhost:6006/api DISABLE_ESLINT_PLUGIN=true storybook dev -p 6006 -c ./storybook",
    "test-storybook": "TARGET_URL=http://localhost:6006 test-storybook --config-dir storybook --verbose",
    "test-coverage": "yarn test-storybook --coverage",
    "analyze-bundle": "craco build && source-map-explorer 'build/static/js/*.js'"
  },
  "dependencies": {
    "@activeledger/activecrypto": "^2.12.3",
    "@activeledger/sdk": "^1.3.6",
    "@activeledger/sdk-bip39": "1.0.3",
    "@akashic/as-backend": "workspace:^",
    "@akashic/core-lib": "workspace:^",
    "@akashic/nitr0gen": "workspace:^",
    "@datadog/browser-rum": "5.0.0",
